@page
@model ToDoApp.Pages.News.IndexModel
@{
    ViewData["Title"] = "Haberler";
}

<h1 class="mb-3">All News</h1>

@if (Model.Articles == null || !Model.Articles.Any())
{
    @* Haber YOKSA bu uyarı çıkar *@
    <div class="alert alert-info">There are no news to represent!</div>
}
else
{
    @* Haber VARSA bu liste basılır *@
    <div class="list-group">
        @foreach (var item in Model.Articles)
        {
            <a asp-page="/News/Details" asp-route-id="@item.Id" class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">@item.Title</h5>
                    <small class="text-muted">@item.PublishedAt?.ToString("yyyy-MM-dd HH:mm")</small>
                </div>

                @if (!string.IsNullOrWhiteSpace(item.Summary))
                {
                    <p class="mb-1">@item.Summary</p>
                }

                <small class="text-muted">@item.AuthorName</small>
            </a>
        }
    </div>
}