@page "{id:guid}" 
@model ToDoApp.Pages.Todos.EditModel
@{
    ViewData["Title"] = "Edit Todo";
}

<h1>Edit Todo</h1>
<form method="post" class="mt-3">
    <input type="hidden" asp-for="Todo.Id" />
    <partial name="_TodoFormModel" for="Todo" />
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
@*Route kısıtlaması yapıyoruz bu sayede /edit/{id} formatında erişim sağlanır. ve id de guid tipinde olmak zorunda*@


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}