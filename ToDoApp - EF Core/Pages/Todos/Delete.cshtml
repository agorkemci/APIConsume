@page "{id:guid}"
@model ToDoApp.Pages.Todos.DeleteModel
@{
    ViewData["Title"] = "Delete To Do Item"; 
}
<h1>Delete To Do Item</h1>
<div class="alert alert-warning mt-3">
    <p><strong>Are you sure you want to delete this item?</strong></p>
    <p class="mb-0">@Model.Todo?.Title</p>
</div>

<form method="post" class="mt-3">
    <input asp-for="Todo.Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>